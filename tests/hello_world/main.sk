use #std/io
use std/arrays

void main(arr args) {
    arr[int] nums = [1, 2, 3, 4, 5]

    sendln(arrays.len(nums))            // 5
    sendln(nums.len())                  // 5 — через точку

    sendln(arrays.find(nums, 3))        // 2
    sendln(arrays.find(nums, 99))       // -1

    arr popped = arrays.pop(nums)       // [1, 2, 3, 4]
    arr erased = arrays.erase(nums, 2)  // [1, 2, 4, 5]
    arr added  = arrays.add(nums, 6)    // [1, 2, 3, 4, 5, 6]
    arr ins    = arrays.insert(nums, 2, 99)  // [1, 2, 99, 3, 4, 5]
    arr pr     = arrays.proem(nums, 0)  // [0, 1, 2, 3, 4, 5]
    arr cutd   = arrays.cut(nums, 1, 5) // [2, 3, 4]
    arr comb   = arrays.combine(nums, [6, 7])  // [1, 2, 3, 4, 5, 6, 7]
    arr[arr] sl = arrays.slice(nums, 2) // [[1, 2, 3], [4, 5]]

    sendln(popped)
    sendln(erased)
    sendln(added)
    sendln(ins)
    sendln(pr)
    sendln(cutd)
    sendln(comb)
    sendln(sl)
}