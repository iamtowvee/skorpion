use #std/io
use std/strings
use std/terminal

void main(arr args) {
  // ============================================================
  // 1. Кодировка консоли (Windows: chcp, Linux: no-op)
  // ============================================================
  setConsoleCode(65001)
  sendln("[setConsoleCode(65001)] — OK")

  // ============================================================
  // 2. Проверка поддержки ANSI
  // ============================================================
  bool ansi = isAnsiSupported()
  if (ansi) {
    sendln("[isAnsiSupported] = true")
  } else {
    sendln("[isAnsiSupported] = false (цвета могут не работать)")
  }

  // ============================================================
  // 3. Базовые стили (чистые коды)
  // ============================================================
  sendln(Bold() + "Bold text" + Reset())
  sendln(Dim() + "Dim text" + Reset())
  sendln(Italic() + "Italic text" + Reset())
  sendln(Underline() + "Underline text" + Reset())
  sendln(Blink() + "Blink text" + Reset())
  sendln(Reverse() + "Reverse text" + Reset())
  sendln(Strike() + "Strike text" + Reset())
  sendln("")

  // ============================================================
  // 4. Foreground-цвета
  // ============================================================
  sendln(FgBlack()   + "FgBlack"   + Reset())
  sendln(FgRed()     + "FgRed"     + Reset())
  sendln(FgGreen()   + "FgGreen"   + Reset())
  sendln(FgYellow()  + "FgYellow"  + Reset())
  sendln(FgBlue()    + "FgBlue"    + Reset())
  sendln(FgMagenta() + "FgMagenta" + Reset())
  sendln(FgCyan()    + "FgCyan"    + Reset())
  sendln(FgWhite()   + "FgWhite"   + Reset())
  sendln("")

  // ============================================================
  // 5. Bright foreground
  // ============================================================
  sendln(FgBrightBlack()   + "FgBrightBlack"   + Reset())
  sendln(FgBrightRed()     + "FgBrightRed"     + Reset())
  sendln(FgBrightGreen()   + "FgBrightGreen"   + Reset())
  sendln(FgBrightYellow()  + "FgBrightYellow"  + Reset())
  sendln(FgBrightBlue()    + "FgBrightBlue"    + Reset())
  sendln(FgBrightMagenta() + "FgBrightMagenta" + Reset())
  sendln(FgBrightCyan()    + "FgBrightCyan"    + Reset())
  sendln(FgBrightWhite()   + "FgBrightWhite"   + Reset())
  sendln("")

  // ============================================================
  // 6. Background-цвета
  // ============================================================
  sendln(BgBlack()   + " BgBlack "   + Reset())
  sendln(BgRed()     + " BgRed "     + Reset())
  sendln(BgGreen()   + " BgGreen "   + Reset())
  sendln(BgYellow()  + " BgYellow "  + Reset())
  sendln(BgBlue()    + " BgBlue "    + Reset())
  sendln(BgMagenta() + " BgMagenta " + Reset())
  sendln(BgCyan()    + " BgCyan "    + Reset())
  sendln(BgWhite()   + " BgWhite "   + Reset())
  sendln("")

  // ============================================================
  // 7. Комбинирование стилей
  // ============================================================
  sendln(Bold() + FgRed() + "Bold red error" + Reset())
  sendln(Bold() + FgGreen() + "Bold green success" + Reset())
  sendln(Underline() + FgBlue() + "Underline blue link" + Reset())
  sendln(FgBlack() + BgYellow() + " WARNING " + Reset())
  sendln(FgWhite() + BgRed() + " ERROR " + Reset())
  sendln("")

  // ============================================================
  // 8. 256-цветный режим
  // ============================================================
  sendln("--- 256 colors ---")
  sendln(Fg256(196, "Fg256(196) bright red"))
  sendln(Fg256(46,  "Fg256(46) bright green"))
  sendln(Fg256(21,  "Fg256(21) bright blue"))
  sendln(Fg256(226, "Fg256(226) bright yellow"))
  sendln(Bg256(196, " Bg256(196) red bg "))
  sendln(Bg256(46,  " Bg256(46) green bg "))
  sendln("")

  // ============================================================
  // 9. RGB True Color
  // ============================================================
  sendln("--- RGB true color ---")
  sendln(FgRGB(255, 100, 0, "FgRGB(255,100,0) orange"))
  sendln(FgRGB(0, 200, 255, "FgRGB(0,200,255) cyan"))
  sendln(FgRGB(255, 0, 255, "FgRGB(255,0,255) magenta"))
  sendln(BgRGB(50, 50, 50, " BgRGB(50,50,50) dark gray "))
  sendln(BgRGB(255, 200, 0, " BgRGB(255,200,0) amber "))
  sendln("")

  // ============================================================
  // 10. Управление экраном
  // ============================================================
  sendln("--- screen ---")
  sendln(Clear() + MoveHome() + "Screen cleared and cursor moved home")
  sendln("Line 2")
  sendln("Line 3")
  sendln(MoveTo(5, 10) + "Moved to row 5, col 10")
  sendln("")

  // ============================================================
  // 11. Курсор
  // ============================================================
  sendln("--- cursor ---")
  sendln("Cursor moves in 3...")
  sendln(CursorHide() + "HIDDEN cursor" + CursorShow())
  sendln(CursorUp(2) + "moved up 2 lines")
  sendln("")

  // ============================================================
  // 12. run() — выполнить команду
  // ============================================================
  sendln("--- run() ---")
  string out = run("echo hello from shell")
  sendln("Shell output: " + out)

  string dir_out = run("dir")
  sendln("First 200 chars of dir:")
  // Обрезаем вывод, чтобы не засыпать экран
  sendln(dir_out)

  // ============================================================
  // 13. Готово
  // ============================================================
  sendln("")
  sendln(Bold() + FgGreen() + "=== All tests passed ===" + Reset())
}