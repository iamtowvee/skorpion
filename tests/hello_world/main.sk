use #lib:iamtowvee/MyLib
use std/files &fs
use std/io
use std/json

const arr X = [15]

void foo(int a, ...some) {
    println(a)
    for (any f in some) {
        println(f)
    }
}

void foos(int a = 10, int b, ...some) {
    println(a + b)
    for (any f in some) {
        println(f)
    }
}

async dict f() {
    return {age: 25}
}

async void something(string msg) {
    println(msg)
}

void main(arr args) {
    const int MAX = 100

    int i = 0
    i += 1               // i = 1
    i -= 2               // i = -1
    i *= 3               // i = -3
    i /= 2               // i = -1
    i %= 2               // i = -1
    i **= 2              // i = 1

    if (MAX == 100) {
        println(MAX + PI)
    }
    
    io.sendln(await f())

    char c = '\n'
    
    foos(_, 10)

    string s = "hello"
    s += " world"        // "hello world"
    s += '!'             // "hello world!"

    fs.writeText("./text", "x", true)
    const string name = "Skorpion" + $(fs.readText("./text"))
    if (fs.exists("./textы")) {
        fs.delete("./textы")
    } else {
        fs.delete("./text")
    }

    float a = 3.143553f
    string x = """FirstLine
\"\"\"Экранирование\"\"\"
"А тут нет"\n
\t""" + $(a^X{3,5}) + """
SOMETHING
"""
    io.sendln(x)

    io.sendln(json.parse("{ \"hi\": 3 }"))

    await something(name)
}