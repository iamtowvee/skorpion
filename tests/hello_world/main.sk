use #std/io
use std/strings

void main(arr args) {
    string s = "Привет, мир!"
    
    sendln(strings.has(s, "мир"))           // true
    sendln(strings.has(s, "Мир"))           // false (регистрозависимо)
    sendln(strings.has(s, "кот"))           // false
    
    sendln(strings.startWith(s, "Прив"))    // true
    sendln(strings.startWith(s, "вет"))     // false
    
    sendln(strings.endWith(s, "мир!"))      // true
    sendln(strings.endWith(s, "!"))         // true
    sendln(strings.endWith(s, "мир"))       // false
    
    // Также работает через точку как метод
    sendln(s.has("!"))                      // true
}