use #lib:iamtowvee/MyLib
use std/os

void foo(int a, ...some) {
    println(a)
    for (any f in some) {
        println(f)
    }
}

void main(arr args) {
    println(getConfigField("name"))            // "MyProject"
    println(getConfigField("buildOutFile"))    // "MyProject-stable-1.0.0.exe"
    println(getConfig())                        // {name: MyProject, ...}
    int x = 0
    while (x < 10) {
        foo(1, -1, true, null, "hi", ["hi"])
        x++
        int i = x++
        println("DEBUG: " + $x + ", " + $i)
    }
}