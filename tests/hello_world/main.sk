use #std/io

const BaseError{msg: string} = new Error
const SpecificError{msg: string, code: int} = new BaseError

void main(arr args) {
    try {
        throw SpecificError{msg: "specific", code: 502}
    } catch (BaseError as e) {
        sendln(e.msg)   // должно вывести "specific"
    }
    sendln("done")
}