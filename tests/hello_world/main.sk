use #std/io

// ============================================================
// 1. Объявление типов ошибок (const + наследование)
// ============================================================
const BaseError{code: int} = new Error
const NetworkError{host: string, code: int[0]} = new BaseError
const TimeoutError{seconds: int[30]} = new NetworkError

// ============================================================
// 2. Простые функции
// ============================================================
int add(int a, int b) {
    return a + b
}

int sub(int a, int b) {
    return a - b
}

int mul(int a, int b) {
    return a * b
}

int divine(int a, int b) {
    if (b == 0) {
        throw BaseError{code: 1, msg: "division by zero"}
    }
    return a / b
}

int mod(int a, int b) {
    return a % b
}

// ============================================================
// 3. Строки
// ============================================================
string greet(string name) {
    return "Hello, " + name + "!"
}

string repeat(string s, int n) {
    string result = ""
    int i = 0
    while (i < n) {
        result = result + s
        i = i + 1
    }
    return result
}

// ============================================================
// 4. Bool и логика
// ============================================================
bool isEven(int x) {
    return x % 2 == 0
}

bool isPositive(int x) {
    return x > 0
}

bool both(bool a, bool b) {
    return a && b
}

bool either(bool a, bool b) {
    return a || b
}

// ============================================================
// 5. Float / double
// ============================================================
float half(int x) {
    return to_float(x) / 2.0f
}

double square(double x) {
    return x * x
}

// ============================================================
// 6. Массивы
// ============================================================
arr[int] makeRange(int start, int end) {
    arr[int] result = (start..end)
    return result
}

int sumArr(arr[int] a) {
    int total = 0
    int i = 0
    while (i < a.length) {
        total = total + a[i]
        i = i + 1
    }
    return total
}

arr[any] makeMixed() {
    arr[any] result = [1, "two", 3.0, true]
    return result
}

// ============================================================
// 7. Any и typeof
// ============================================================
string describe(any x) {
    return type(x) + " = " + $x
}

// ============================================================
// 8. Встроенные конвертации
// ============================================================
string demoConversions() {
    string s = "42"
    int i = to_int(s)
    float f = to_float("3.14")
    double d = to_double("2.71828")
    bool b = to_bool(1)
    string back = to_string(i) + "," + to_string(f) + "," + to_string(d) + "," + to_string(b)
    return back
}

// ============================================================
// 9. If / elsif / else
// ============================================================
string classify(int x) {
    if (x < 0) {
        return "negative"
    } elsif (x == 0) {
        return "zero"
    } else {
        return "positive"
    }
}

// ============================================================
// 10. Ternary
// ============================================================
string sign(int x) {
    return x >= 0 ? "non-negative" : "negative"
}

// ============================================================
// 11. While
// ============================================================
int factorial(int n) {
    int result = 1
    int i = 1
    while (i <= n) {
        result = result * i
        i = i + 1
    }
    return result
}

// ============================================================
// 12. Case
// ============================================================
string dayName(int day) {
    case (day) {
        1 { return "Monday" },
        2 { return "Tuesday" },
        3 { return "Wednesday" },
        4 { return "Thursday" },
        5 { return "Friday" },
        6 { return "Saturday" },
        7 { return "Sunday" },
        _ { return "Unknown" },
    }
    return "?"
}

// ============================================================
// 13. Try / catch / throw
// ============================================================
int safedivide(int a, int b) {
    try {
        return divine(a, b)
    } catch (BaseError as e) {
        sendln("Caught: " + e.msg + " (code " + to_string(e.code) + ")")
        return -1
    }
}

void throwNetworkError() {
    throw NetworkError{host: "example.com", msg: "connection failed"}
}

void demoTry() {
    try {
        throwNetworkError()
    } catch (NetworkError as e) {
        sendln("Network error: host=" + e.host + " msg=" + e.msg)
    } catch (Error as err) {
        sendln("Generic error: " + err.msg)
    }
}

void demoTimeout() {
    try {
        throw TimeoutError{host: "slow.com", msg: "timed out"}
    } catch (TimeoutError as e) {
        sendln("Timeout: " + e.host + " (" + to_string(e.seconds) + "s) — " + e.msg)
    }
}

// ============================================================
// 14. Range call
// ============================================================
int sum3(int a, int b, int c) {
    return a + b + c
}

// ============================================================
// 15. Include C
// ============================================================
int c_add(int a, int b) {
    includeC ~~~
        return sk_int_new(a.value + b.value);
    ~~~
    return 0
}

// ============================================================
// 16. Default parameters
// ============================================================
string greetDefault(string name = "world", string greeting = "Hello") {
    return greeting + ", " + name + "!"
}

// ============================================================
// 17. Non-exportable function (звёздочка)
// ============================================================
int *secret() {
    return 42
}

// ============================================================
// MAIN
// ============================================================
void main(arr args) {
    sendln("=== Skorpion Language Test ===")
    sendln("")

    // Арифметика
    sendln("--- Arithmetic ---")
    sendln("add(2, 3) = " + to_string(add(2, 3)))
    sendln("sub(10, 4) = " + to_string(sub(10, 4)))
    sendln("mul(3, 5) = " + to_string(mul(3, 5)))
    sendln("divine(20, 4) = " + to_string(divine(20, 4)))
    sendln("mod(17, 5) = " + to_string(mod(17, 5)))
    sendln("")

    // Строки
    sendln("--- Strings ---")
    sendln(greet("Skorpion"))
    sendln(repeat("ab", 3))
    sendln("")

    // Bool
    sendln("--- Bool ---")
    sendln("isEven(4) = " + to_string(isEven(4)))
    sendln("isEven(7) = " + to_string(isEven(7)))
    sendln("isPositive(-5) = " + to_string(isPositive(-5)))
    sendln("both(true, false) = " + to_string(both(true, false)))
    sendln("either(true, false) = " + to_string(either(true, false)))
    sendln("")

    // Float / double
    sendln("--- Float / Double ---")
    sendln("half(7) = " + to_string(half(7)))
    sendln("square(3.0) = " + to_string(square(3.0)))
    sendln("")

    // Массивы
    sendln("--- Arrays ---")
    arr[int] r = makeRange(1, 5)
    sendln("range(1..5) = " + $r)
    sendln("sumArr = " + to_string(sumArr(r)))
    sendln("")

    arr[any] mixed = makeMixed()
    sendln("mixed = " + $mixed)
    sendln("")

    // Any и typeof
    sendln("--- Any / typeof ---")
    sendln(describe(42))
    sendln(describe("hello"))
    sendln(describe(3.14))
    sendln(describe(true))
    sendln("")

    // Конвертации
    sendln("--- Conversions ---")
    sendln(demoConversions())
    sendln("")

    // If / elsif / else
    sendln("--- If / elsif / else ---")
    sendln("classify(-5) = " + classify(-5))
    sendln("classify(0) = " + classify(0))
    sendln("classify(7) = " + classify(7))
    sendln("")

    // Ternary
    sendln("--- Ternary ---")
    sendln("sign(-3) = " + sign(-3))
    sendln("sign(3) = " + sign(3))
    sendln("")

    // While
    sendln("--- Loops ---")
    sendln("factorial(5) = " + to_string(factorial(5)))
    sendln("")

    // Case
    sendln("--- Case ---")
    sendln("dayName(1) = " + dayName(1))
    sendln("dayName(7) = " + dayName(7))
    sendln("dayName(99) = " + dayName(99))
    sendln("")

    // Try / catch
    sendln("--- Try / catch / throw ---")
    sendln("safedivide(10, 2) = " + to_string(safedivide(10, 2)))
    sendln("safedivide(10, 0) = " + to_string(safedivide(10, 0)))
    demoTry()
    demoTimeout()
    sendln("")

    // Range call
    sendln("--- Range call ---")
    sendln("(1..3).sum3() = " + to_string((1..3).sum3()))
    sendln("")

    // Include C
    sendln("--- Include C ---")
    sendln("c_add(5, 7) = " + to_string(c_add(5, 7)))
    sendln("")

    // Default parameters
    sendln("--- Default parameters ---")
    sendln(greetDefault())
    sendln(greetDefault("Skorpion"))
    sendln(greetDefault("Skorpion", "Hi"))
    sendln("")

    // Non-exportable
    sendln("--- Non-exportable ---")
    sendln("secret() = " + to_string(secret()))
    sendln("")

    // Null
    sendln("--- Null ---")
    int x = null
    string s = null
    arr[int] a = null
    sendln("type(x) = " + type(x) + ", $x = " + $x)
    sendln("type(s) = " + type(s) + ", $s = " + $s)
    sendln("type(a) = " + type(a) + ", $a = " + $a)
    sendln("type(null) = " + type(null))
    sendln("")

    // Гетерогенный массив без null
    arr[any] het = [1, "two", 3.5, true]
    sendln("heterogeneous = " + $het)
    sendln("")

    sendln("=== All tests passed ===")
}