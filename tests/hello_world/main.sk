use #lib:iamtowvee/MyLib
use std/os
use std/io

void foo(int a, ...some) {
    println(a)
    for (any f in some) {
        println(f)
    }
}

async dict f() {
    return {age: 25}
}

async void something(string msg) {
    println(msg)
}

void main(arr args) {
    const int MAX = 100

    int i = 0
    i += 1               // i = 1
    i -= 2               // i = -1
    i *= 3               // i = -3
    i /= 2               // i = -1
    i %= 2               // i = -1
    i **= 2              // i = 1

    if (MAX == 100) {
        println(MAX + PI)
    }

    io.sendln(await f())

    string s = "hello"
    s += " world"        // "hello world"
    s += '!'             // "hello world!"

    const string name = "Skorpion"

    await something(name)
}