use #std/os
use #std/io

void main(arr args) {
    setEnv("MY_VAR", "first")
    sendln(getEnv("MY_VAR"))    // first

    setClearEnv("MY_VAR", "second", false)
    sendln(getEnv("MY_VAR"))    // first (не перезаписано)

    setClearEnv("MY_VAR", "third", true)
    sendln(getEnv("MY_VAR"))    // third (перезаписано)
}