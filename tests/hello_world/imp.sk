use #std/io

new MyError{msg: string} inherit Error

//Deprecated tip:"hi"
async int *failFunc() { // * перед именем функции, значит что функция локальная (ее невозможно вызвать извне напрямую)
    int i = 0
    while (i < 5000000) { i = i + 1 } // чуть-чуть подождем
    throw MyError{msg: "boom in async"}
    return i
}

void main(arr args) {
    sendln("Запускаем падающий async...")
    int r = failFunc()
    sendln("Ждем...")
    int v = await r
    sendln("Этого не должно быть видно!") // Если это вывелось — ошибка
}