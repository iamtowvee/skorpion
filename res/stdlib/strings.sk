// UTF-8: длина строки в символах
size_t __sk__utf8__strlen(const char *s) {
    size_t count = 0;
    while (*s) {
        if ((*s & 0xC0) != 0x80) count++;
        s++;
    }
    return count;
}

// UTF-8: декодирование одного символа
// Возвращает codepoint, а через *len — длину в байтах
unsigned int __sk__utf8__decode(const char *s, int *len) {
    unsigned char c = (unsigned char)s[0];
    if (c < 0x80) { *len = 1; return c; }
    if ((c & 0xE0) == 0xC0) {
        *len = 2;
        return ((c & 0x1F) << 6) | (s[1] & 0x3F);
    }
    if ((c & 0xF0) == 0xE0) {
        *len = 3;
        return ((c & 0x0F) << 12) | ((s[1] & 0x3F) << 6) | (s[2] & 0x3F);
    }
    if ((c & 0xF8) == 0xF0) {
        *len = 4;
        return ((c & 0x07) << 18) | ((s[1] & 0x3F) << 12) | ((s[2] & 0x3F) << 6) | (s[3] & 0x3F);
    }
    *len = 1;
    return c;
}

// UTF-8: кодирование codepoint в буфер
// Возвращает длину в байтах
int __sk__utf8__encode(unsigned int cp, char *out) {
    if (cp < 0x80) {
        out[0] = (char)cp;
        return 1;
    }
    if (cp < 0x800) {
        out[0] = (char)(0xC0 | (cp >> 6));
        out[1] = (char)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp < 0x10000) {
        out[0] = (char)(0xE0 | (cp >> 12));
        out[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[2] = (char)(0x80 | (cp & 0x3F));
        return 3;
    }
    out[0] = (char)(0xF0 | (cp >> 18));
    out[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    out[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
    out[3] = (char)(0x80 | (cp & 0x3F));
    return 4;
}

// Приведение одного codepoint к верхнему регистру
unsigned int __sk__utf8__to_upper(unsigned int cp) {
    // ASCII
    if (cp < 0x80) return (unsigned int)toupper((int)cp);
    // Кириллица: а-я (0x430-0x44F) → А-Я (0x410-0x42F)
    if (cp >= 0x430 && cp <= 0x44F) return cp - 0x20;
    // Кириллица: ё (0x451) → Ё (0x401)
    if (cp == 0x451) return 0x401;
    // Латиница с диакритикой (базовые случаи)
    if (cp >= 0xE0 && cp <= 0xFE && cp != 0xF7) return cp - 0x20;
    if (cp == 0xFF) return 0x178;
    // Греческий: α-ω (0x3B1-0x3C9) → Α-Ω (0x391-0x3A9)
    if (cp >= 0x3B1 && cp <= 0x3C9 && cp != 0x3C2) return cp - 0x20;
    if (cp == 0x3C2) return 0x3A3;
    return cp;
}

// Приведение одного codepoint к нижнему регистру
unsigned int __sk__utf8__to_lower(unsigned int cp) {
    // ASCII
    if (cp < 0x80) return (unsigned int)tolower((int)cp);
    // Кириллица: А-Я (0x410-0x42F) → а-я (0x430-0x44F)
    if (cp >= 0x410 && cp <= 0x42F) return cp + 0x20;
    // Кириллица: Ё (0x401) → ё (0x451)
    if (cp == 0x401) return 0x451;
    // Латиница с диакритикой
    if (cp >= 0xC0 && cp <= 0xDE && cp != 0xD7) return cp + 0x20;
    if (cp == 0x178) return 0xFF;
    // Греческий: Α-Ω (0x391-0x3A9) → α-ω (0x3B1-0x3C9)
    if (cp >= 0x391 && cp <= 0x3A9) return cp + 0x20;
    return cp;
}

// Общая функция изменения регистра
char* __sk__utf8__change_case(const char *src, int mode) {
    // mode: 0 = lower, 1 = upper, 2 = capital
    size_t src_len = strlen(src);
    // В худшем случае: каждый символ = 4 байта + '\0'
    char *out = malloc(src_len * 4 + 1);
    if (!out) return NULL;

    size_t i = 0, o = 0;
    int word_start = 1; // для capital case

    while (src[i]) {
        int char_len = 0;
        unsigned int cp = __sk__utf8__decode(&src[i], &char_len);

        unsigned int new_cp = cp;
        switch (mode) {
            case 0: // lower
                new_cp = __sk__utf8__to_lower(cp);
                break;
            case 1: // upper
                new_cp = __sk__utf8__to_upper(cp);
                break;
            case 2: // capital
                if (word_start) {
                    new_cp = __sk__utf8__to_upper(cp);
                } else {
                    new_cp = __sk__utf8__to_lower(cp);
                }
                // Определяем начало слова: пробел, таб, новая строка, пунктуация
                word_start = (cp == ' ' || cp == '\t' || cp == '\n' ||
                              cp == '\r' || cp == '.' || cp == ',' ||
                              cp == '!' || cp == '?' || cp == ';' ||
                              cp == ':' || cp == '-' || cp == '(' ||
                              cp == ')' || cp == '[' || cp == ']');
                break;
        }

        o += __sk__utf8__encode(new_cp, &out[o]);
        i += char_len;
    }

    out[o] = '\0';
    return out;
}
~~~

/* === Length === */

int len(string line) {
  if (line == null) {
    throw VoidLengthMeasurementError{msg: "Cannot get length 'null'."}
  }
  includeC ~~~
    size_t len = __sk__utf8__strlen(line);
    int n = (len > INT_MAX) ? -1 : (int)len;
    return n;
  ~~~
  return 0
}

int bytes(string line) {
  if (line == null) {
    throw VoidBytesMeasurementError{msg: "Cannot get byte length 'null'."}
  }
  includeC ~~~
    return strlen(line);
  ~~~
  return 0
}

/* === Concat === */

string concat(string a, string b) {{
  if (a == null || b == null) {
    throw VoidConcatError{msg: "Cannot concatenate 'null' with string or 'null'."}
  }
  return a + b
}

/* === Case === */

string toLowerCase(string line) {
  if (line == null) {
    throw VoidLowerizeError{msg: "Unable to convert 'null' to lower case."}
  }
  includeC ~~~
    return __sk__utf8__change_case(line, 0);
  ~~~
  return ""
}

string toUpperCase(string line) {
  if (line == null) {
    throw VoidUpperizeError{msg: "Unable to convert 'null' to UPPER CASE."}
  }
  includeC ~~~
    return __sk__utf8__change_case(line, 1);
  ~~~
  return ""
}

string toCapitalCase(string line) {
  if (line == null) {
    throw VoidCapitalizeError{msg: "Unable to convert 'null' to Capital Case."}
  }
  includeC ~~~
    return __sk__utf8__change_case(line, 2);
  ~~~
  return ""
}