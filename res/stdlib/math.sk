use std/strings

const ZeroDivError{} = new Error
const ImpossibleOperationOverNullError{} = new Error
const SqrtFromNumLessZeroError{} = new Error
const BadRootDegreeError{} = new Error
const DomainError{} = new Error

/* ============================
   Helpers
   ============================ */

void nullProc(any a, any b, string op) {
  if (a == null || b == null) {
    string errline = "Cannot use 'null' in '" + op + "'"
    throw ImpossibleOperationOverNullError{msg: errline}
  }
}

void nullProcOne(any a, string op) {
  if (a == null) {
    string errline = "Cannot use 'null' in '" + op + "'"
    throw ImpossibleOperationOverNullError{msg: errline}
  }
}

/* ============================
   Arithmetic
   ============================ */

T<int,float,double> add(T<int,float,double> a, T<int,float,double> b) {
  nullProc(a, b, "add()")
  return a + b
}

T<int,float,double> minus(T<int,float,double> a, T<int,float,double> b) {
  nullProc(a, b, "minus()")
  return a - b
}

T<int,float,double> mul(T<int,float,double> a, T<int,float,double> b) {
  nullProc(a, b, "mul()")
  return a * b
}

T<int,float,double> div(T<int,float,double> a, T<int,float,double> b) {
  nullProc(a, b, "div()")
  if (b == 0 || b == 0.0 || b == 0.0f) {
    throw ZeroDivError{msg: "You can't divide by zero."}
  }
  return a / b
}

T<int,float,double> pow(T<int,float,double> a, T<int,float,double> b) {
  nullProc(a, b, "pow()")
  return a ** b
}

T<int,float,double> invert(T<int,float,double> a) {
  nullProcOne(a, "invert()")
  return -a
}

T<int,float,double> unsign(T<int,float,double> a) {
  nullProcOne(a, "unsign()")
  if (a < 0) {
    return -a
  }
  return a
}

/* ============================
   Roots
   ============================ */

T<int,float,double> sqrt(T<int,float,double> a, int n = 2) {
  includeC ~~~
    if (a.type == 6) return any_null();
    if (n.value <= 0) {
        BadRootDegreeError* err = malloc(sizeof(BadRootDegreeError));
        err->__type = "Error.BadRootDegreeError";
        err->msg = sk_string_new("Root degree must be positive.");
        sk_throw(err, "<builtin:std/math>", 90, 5);
    }
    double av = any_to_double(a).value;
    if (av < 0.0) {
        if (n.value % 2 == 0) {
            SqrtFromNumLessZeroError* err = malloc(sizeof(SqrtFromNumLessZeroError));
            err->__type = "Error.SqrtFromNumLessZeroError";
            err->msg = sk_string_new("It is impossible to get the even root of a negative number.");
            sk_throw(err, "<builtin:std/math>", 97, 5);
        }
        return any_double(sk_double_new(-pow(-av, 1.0 / (double)n.value)));
    }
    return any_double(sk_double_new(pow(av, 1.0 / (double)n.value)));
  ~~~
  return 0.0
}

