int toInt(any value) {
  int result = 0
  case (type(value)) {
    "int" {
      result = value
    },
    "int" {
      result = value
    },
    "int" {
      result = value
    },
    _ {
      result = 0
    },
  }
  return result
}

int toBool(any value) {
  return value.to_int()
}