string getEnv(string env) {
  includeC ~~~
    char* val = getenv(env);
    return val ? strdup(val) : strdup("");
  ~~~
}

void setEnv(string env, string val) {
  includeC ~~~
    #if defined(_WIN32)
        if (getenv(env) == NULL) {
            _putenv_s(env, val);
        }
    #elif defined(__linux__)
        setenv(env, val, 0);
    #endif
  ~~~
}

void setClearEnv(string env, string val, bool confirm) {
  if (!confirm) {
    return
  }
  includeC ~~~
    #if defined(_WIN32)
        _putenv_s(env, val);
    #elif defined(__linux__)
        setenv(env, val, 1);
    #endif
  ~~~
}